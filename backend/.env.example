# Copy this file to ".env" and fill in your actual local values.
# Never commit the real ".env" file to Git.

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=attendance_user
DB_PASSWORD=attendance_pass
DB_NAME=attendance_db

# Flask app settings
FLASK_ENV=development
FLASK_DEBUG=True

# JWT secret used to sign login tokens (use a long random string in real use)
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_EXPIRY_HOURS=8

# Frontend origin allowed to call this API (used by Flask-CORS)
FRONTEND_ORIGIN=http://localhost:5173
